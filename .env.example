APP_NAME=HK_Filament
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tu-dominio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hk_autenticacion
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tu-dominio.com
SESSION_COOKIE=hunabku_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo SMTP (Gmail con contrasena de aplicacion)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME="tu-correo@gmail.com"
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_ENCRYPTION=smtps
MAIL_FROM_ADDRESS="tu-correo@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Servidor de Autenticacion (SSO)
AUTH_SERVER_URL=http://hk-autenticacion:8001

# Google OAuth (Login con Google)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=http://tu-dominio.com/auth/google/callback

# Facebook OAuth (opcional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://tu-dominio.com/auth/facebook/callback

# Evolution API (WhatsApp)
EVOLUTION_BASE_URL=http://evolution_api:8080
EVOLUTION_API_KEY=tu_api_key_de_evolution

# Google Calendar
GOOGLE_CALENDAR_ID=primary
APP_TIMEZONE="America/Mexico_City"

# IMAP Gmail (para Resumen de Correos con IA)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=tu-correo@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# Groq API (Motor de IA)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxx
